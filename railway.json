{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'Skipping frontend build for backend service'"
  },
  "deploy": {
    "startCommand": "node server/index.js",
    "healthcheckPath": "/health",
